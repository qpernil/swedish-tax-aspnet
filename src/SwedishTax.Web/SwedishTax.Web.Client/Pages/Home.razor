@page "/"
@using System.Globalization
@implements IHandleEvent
@implements IDisposable
@inject IRustTaxEngine Engine

<PageTitle>Swedish Tax 2026</PageTitle>

<main class="calculator">
    <header class="page-header">
        <div>
            <h1>Swedish Tax 2026</h1>
            <p>Annual income, withholding and pension planning</p>
        </div>
        <span class="year-label">Income year 2026</span>
    </header>

    <p class="section-copy" role="status">@statusText</p>
    @if (engineError is not null)
    {
        <p class="invalid-plan" role="alert">@engineError</p>
        <button type="button" @onclick="RetryAsync">Retry engine</button>
    }
    @if (storageWarning is not null)
    {
        <p class="invalid-plan" role="alert">@storageWarning</p>
        @if (!canSave)
        {
            <button type="button" @onclick="UseCurrentWorkspace">Replace saved workspace with this plan</button>
        }
    }
    <fieldset class="workspace-controls" disabled="@(!initialized)">
    <section class="input-panel" aria-labelledby="inputs-heading">
        <h2 id="inputs-heading">Inputs</h2>
        <div class="controls plan-controls">
            <div class="control compact-control selector-help-control">
                <div class="control-heading"><label for="tax-table">Tax table</label></div>
                <select id="tax-table" aria-describedby="tax-table-help" @bind="table">
                    @for (var option = 29; option <= 42; option++)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
                <aside id="tax-table-help" class="selector-help-panel table-help-panel" role="tooltip">
                    <strong>Find your tax table</strong>
                    <p>Open your A-tax certificate under <b>Mina sidor</b> on skatteverket.se. It states which table your payer should use.</p>
                    <small>The table is based on where you were registered on 1 November of the preceding year.</small>
                </aside>
            </div>

            <label class="control age-control">
                <span>Age at start of 2026</span>
                <select @bind="ageGroup">
                    <option value="@TaxAgeGroup.Under66AtYearStart">Under 66</option>
                    <option value="@TaxAgeGroup.AtLeast66AtYearStart">66 or older</option>
                </select>
            </label>

            <div class="control income-plan-control">
                <span>@((result?.HasUniformMonthlyTableReference ?? false) ? "Monthly income" : "Annual income plan")</span>
                <button type="button" class="plan-button" @onclick="() => editorOpen = !editorOpen" aria-expanded="@editorOpen">
                    <strong>@FormatSek((result?.HasUniformMonthlyTableReference ?? false) ? (result?.Totals.MonthlyTaxableIncome ?? 0) : (result?.Totals.GrossIncome ?? 0))</strong>
                    <small>@((result?.HasUniformMonthlyTableReference ?? false) ? "/ month" : "/ year") · Edit…</small>
                </button>
            </div>
        </div>
    </section>

    @if (editorOpen)
    {
        <section class="income-editor" aria-labelledby="income-editor-heading">
            <div class="section-heading">
                <div>
                    <h2 id="income-editor-heading">Income calculator</h2>
                    <p>Build the year from income rows. Each row shows how the payer withholding is calculated.</p>
                </div>
                <button type="button" class="secondary-button" @onclick="() => editorOpen = false">Apply and close</button>
            </div>

            <div class="adjustment-panel">
                <label class="check-field">
                    <input type="checkbox" @bind="HasAdjustment" />
                    <span>I have a percentage jämkning decision</span>
                </label>
                @if (HasAdjustment)
                {
                    <label class="inline-rate">
                        <span>Decision rate</span>
                        <input type="number" min="0" max="100" @bind="AdjustmentPercent" />
                        <small>%</small>
                    </label>
                    <p>
                        Mark the income rows covered by the decision. For a calibrated final-tax projection,
                        also identify the recurring salary whose full-year projection was the decision basis.
                    </p>
                }
            </div>

            <div class="income-list">
                @foreach (var entry in Plan.Entries)
                {
                    var estimate = CurrentWithholding.Entries.FirstOrDefault(item => item.EntryId == entry.Id);
                    <IncomeEntryEditor @key="entry.Id"
                                       Entry="entry"
                                       HasAdjustment="@HasAdjustment"
                                       Withholding="estimate"
                                       Allowance="entry.Result?.Allowance"
                                       OnChange="RowChanged"
                                       OnRemove="RemoveEntry" />
                }
            </div>

            <div class="add-income-row">
                <select @bind="newIncomeKind">
                    @foreach (var kind in Enum.GetValues<IncomeKind>())
                    {
                        <option value="@kind">@kind.Label()</option>
                    }
                </select>
                <button type="button" class="primary-button" @onclick="AddIncome">+ Add income</button>
            </div>
        </section>
    }

    @if (result?.Calculation is { } calculation)
    {
        <section class="results" aria-labelledby="result-heading">
            <div class="section-heading result-heading">
                <h2 id="result-heading">Tax result</h2>
                <span>Table @table / salary column @((byte)(result?.SalaryColumn ?? 1)) / pension column @((byte)(result?.PensionColumn ?? 6))</span>
            </div>

            <div class="summary-grid">
                <article class="summary-item formula-summary">
                    <span>@(calculation.AdjustmentCalibration is null ? "Final tax estimate" : "Jämkning-calibrated tax projection")</span>
                    <strong>@FormatSek(calculation.TotalTax)</strong>
                    <small>Marginal tax @calculation.MarginalRate.ToString("F1", CultureInfo.InvariantCulture)%</small>
                </article>
                <article class="summary-item official-summary">
                    <span>Calculated withholding</span>
                    <strong>@FormatSek(calculation.WithheldTax)</strong>
                    <small>Cash after withholding @FormatSek(calculation.CashAfterWithholding)</small>
                </article>
                <article class="summary-item net-summary">
                    <span>Annual net after final tax</span>
                    <strong>@FormatSek(calculation.AnnualNet)</strong>
                    <small>@TaxBalanceSummary(calculation.TaxBalance)</small>
                </article>
            </div>

            <div class="data-section">
                <h3>Annual reconciliation</h3>
                <dl class="value-list comparison-list">
                    <div><dt>Taxable salary and pension</dt><dd>@FormatSek(calculation.Totals.OrdinaryIncome)</dd></div>
                    @if (calculation.Totals.DividendIncome > 0)
                    {
                        <div><dt>Own-AB dividend</dt><dd>@FormatSek(calculation.Totals.DividendIncome)</dd></div>
                        <div><dt>Total income including dividend</dt><dd>@FormatSek(calculation.Totals.GrossIncome)</dd></div>
                    }
                    @if (calculation.Totals.SalaryExchangeSacrifice > 0)
                    {
                        <div><dt>Salary exchanged</dt><dd>@FormatSek(calculation.Totals.SalaryExchangeSacrifice)</dd></div>
                    }
                    @if (calculation.Totals.TotalEmployerPensionContributions > 0)
                    {
                        <div><dt>Modeled employer pension contributions</dt><dd>@FormatSek(calculation.Totals.TotalEmployerPensionContributions)</dd></div>
                        <div><dt>Regular pension contributions</dt><dd>@FormatSek(calculation.RegularPensionPremiums)</dd></div>
                        <div><dt>Vacation pension contributions</dt><dd>@FormatSek(calculation.VacationPensionPremiums)</dd></div>
                        <div><dt>Salary exchange pension contributions</dt><dd>@FormatSek(calculation.SalaryExchangePensionContributions)</dd></div>
                        <div><dt>Current-year pensionable salary basis</dt><dd>@FormatSek(calculation.PensionSalaryBasis)</dd></div>
                        <div><dt>Modeled pension share of current-year basis</dt><dd>@calculation.EmployerPensionShareOfBasis.ToString("F2")%</dd></div>
                    }
                    <div><dt>Effective final tax rate</dt><dd>@calculation.EffectiveRate.ToString("F2", CultureInfo.InvariantCulture)%</dd></div>
                    <div><dt>Calculated tax withheld</dt><dd>@FormatSek(calculation.WithheldTax)</dd></div>
                    <div><dt>Cash after withholding</dt><dd>@FormatSek(calculation.CashAfterWithholding)</dd></div>
                    <div><dt>@(calculation.AdjustmentCalibration is null ? "Estimated final tax" : "Jämkning-calibrated tax projection")</dt><dd>@FormatSek(calculation.TotalTax)</dd></div>
                    @if (calculation.TaxBalance > 0)
                    {
                        <div class="balance-due"><dt>Expected kvarskatt</dt><dd>@FormatSek((uint)calculation.TaxBalance)</dd></div>
                    }
                    else if (calculation.TaxBalance < 0)
                    {
                        <div class="balance-refund"><dt>Expected refund</dt><dd>@FormatSek((uint)-calculation.TaxBalance)</dd></div>
                    }
                    else
                    {
                        <div><dt>Expected balance</dt><dd>@FormatSek(0)</dd></div>
                    }
                </dl>
            </div>

            <details class="trace-panel data-section">
                <summary>Show calculation trace…</summary>
                <h3>1. Cash income from entered rows</h3>
                <dl class="value-list">
                    @foreach (var entry in Plan.Entries)
                    {
                        <div><dt>@EntryName(entry) <small>@CashEquation(entry)</small></dt><dd>@FormatSek(entry.TotalAnnualAmount)</dd></div>
                    }
                    <div class="total-row"><dt>Total cash income</dt><dd>@FormatSek(calculation.Totals.GrossIncome)</dd></div>
                </dl>
                <h3>2. Payer withholding</h3>
                <dl class="value-list">
                    @foreach (var estimate in CurrentWithholding.Entries)
                    {
                        var entry = Plan.Entries.First(item => item.Id == estimate.EntryId);
                        <div><dt>@EntryName(entry) <small>@WithholdingRuleText(estimate.Rule)@AdditionalRuleText(estimate)</small></dt><dd>@FormatSek(estimate.Withheld)</dd></div>
                    }
                    <div class="total-row"><dt>Total withheld</dt><dd>@FormatSek(calculation.WithheldTax)</dd></div>
                </dl>
                @if (calculation.AdjustmentBalanceTrace is { } balanceTrace)
                {
                    <h3>Jämkning balance trace</h3>
                    <dl class="value-list">
                        <div><dt>Formula tax change from decision basis</dt><dd>@FormatSignedSek(balanceTrace.FormulaTaxChange)</dd></div>
                        <div><dt>Withholding change from decision basis</dt><dd>@FormatSignedSek(balanceTrace.WithholdingChange)</dd></div>
                        <div><dt>Ordinary-income balance</dt><dd>@FormatSignedSek(balanceTrace.OrdinaryBalance)</dd></div>
                    </dl>
                }
                <h3>3. Annual formula and balance</h3>
                <p class="trace-equation">
                    @FormatSek(calculation.AnnualTax.Total) ordinary formula tax
                    @if (calculation.AdjustmentCalibration is { } calibration)
                    {
                        <span> − @FormatSignedSek(calibration.ImpliedTaxAdjustment) calibrated adjustment</span>
                    }
                    @if (calculation.DividendTax > 0)
                    {
                        <span> + @FormatSek(calculation.DividendTax) dividend tax</span>
                    }
                    = <strong>@FormatSek(calculation.TotalTax)</strong> projected final tax.
                    Final tax minus withholding = <strong>@FormatSignedSek(calculation.TaxBalance)</strong>.
                </p>
            </details>

            <div class="data-section">
                <h3>Average monthly equivalent</h3>
                <p class="section-copy">Reference only: annual taxable salary and pension divided by 12, then looked up as salary in the selected table. Actual payer withholding is calculated separately above.</p>
                <dl class="value-list comparison-list">
                    <div><dt>Average monthly taxable income</dt><dd>@FormatSek(calculation.MonthlyIncome)</dd></div>
                    <div><dt>Table @table, salary column @((byte)(result?.SalaryColumn ?? 1))</dt><dd>@FormatDeduction(calculation.TableDeduction)</dd></div>
                    <div><dt>Annualized table deduction (12 months)</dt><dd>@FormatSek(calculation.AnnualizedTableReferenceTax)</dd></div>
                    <div><dt>Cash after table deduction</dt><dd>@FormatSek(calculation.TableReferenceNet)</dd></div>
                </dl>
            </div>

            <div class="data-section basis-section">
                <h3>Income-basis ceilings</h3>
                <p class="section-copy">PGI uses salary and one-time work compensation; SGI uses the annualized recurring salary rate.</p>
                <div class="basis-grid">
                    @IncomeBasisCard("Allmän pension (PGI)", calculation.PensionProgress)
                    @IncomeBasisCard("Estimated SGI", calculation.SgiProgress)
                </div>
            </div>

            <div class="data-section breakdown-section">
                <h3>@(calculation.AdjustmentCalibration is null ? "Annual formula breakdown" : "Annual tax projection breakdown")</h3>
                <dl class="value-list breakdown-list">
                    <div><dt>Assessed income</dt><dd>@FormatSek(calculation.AnnualTax.AssessedIncome)</dd></div>
                    <div><dt>Basic allowance</dt><dd>@FormatSek(calculation.AnnualTax.BasicAllowance)</dd></div>
                    <div><dt>Taxable income</dt><dd>@FormatSek(calculation.AnnualTax.TaxableIncome)</dd></div>
                    <div><dt>State income tax</dt><dd>@FormatSek(calculation.AnnualTax.StateIncomeTax)</dd></div>
                    <div><dt>Municipal income tax</dt><dd>@FormatSek(calculation.AnnualTax.MunicipalIncomeTax)</dd></div>
                    <div><dt>Burial and religious fee</dt><dd>@FormatSek(calculation.AnnualTax.BurialAndReligiousFee)</dd></div>
                    <div><dt>General pension fee</dt><dd>@FormatSek(calculation.AnnualTax.PensionFee)</dd></div>
                    <div><dt>General pension fee credit</dt><dd>@FormatCredit(calculation.AnnualTax.PensionFeeCredit)</dd></div>
                    <div><dt>Work income credit</dt><dd>@FormatCredit(calculation.AnnualTax.WorkIncomeCredit)</dd></div>
                    <div><dt>Sickness compensation credit</dt><dd>@FormatCredit(calculation.AnnualTax.SicknessCompensationCredit)</dd></div>
                    <div><dt>Earned income credit</dt><dd>@FormatCredit(calculation.AnnualTax.EarnedIncomeCredit)</dd></div>
                    <div><dt>Public service fee</dt><dd>@FormatSek(calculation.AnnualTax.PublicServiceFee)</dd></div>
                    <div><dt>Total tax and fees before credits</dt><dd>@FormatSek(calculation.AnnualTax.AdditionsTotal)</dd></div>
                    <div><dt>Total credits</dt><dd>@FormatCredit(calculation.AnnualTax.CreditsTotal)</dd></div>
                    <div class="total-row"><dt>Formula annual tax</dt><dd>@FormatSek(calculation.AnnualTax.Total)</dd></div>
                </dl>
                @if (calculation.AdjustmentCalibration is { } adjustment)
                {
                    <h3 class="subheading">Jämkning calibration</h3>
                    <dl class="value-list comparison-list">
                        <div><dt>Full-year decision basis</dt><dd>@FormatSek(adjustment.BasisIncome)</dd></div>
                        <div><dt>Formula tax at decision basis</dt><dd>@FormatSek(adjustment.FormulaTaxAtBasis)</dd></div>
                        <div><dt>Tax assumed by @adjustment.Percent% decision</dt><dd>@FormatSek(adjustment.AssumedTaxAtBasis)</dd></div>
                        <div><dt>Implied tax adjustment</dt><dd>@FormatSignedSek(adjustment.ImpliedTaxAdjustment)</dd></div>
                        <div class="total-row"><dt>Projected ordinary-income tax</dt><dd>@FormatSek(adjustment.ProjectedOrdinaryTax)</dd></div>
                    </dl>
                }
                @if (calculation.Totals.DividendIncome > 0)
                {
                    <h3 class="subheading">Dividend</h3>
                    <dl class="value-list comparison-list">
                        <div><dt>Own-AB dividend</dt><dd>@FormatSek(calculation.Totals.DividendIncome)</dd></div>
                        <div><dt>Dividend tax at 20%</dt><dd>@FormatSek(calculation.DividendTax)</dd></div>
                        <div class="total-row"><dt>Total final tax</dt><dd>@FormatSek(calculation.TotalTax)</dd></div>
                    </dl>
                }
            </div>
        </section>
    }
    else
    {
        @if (issue is not null)
        {
            <p class="invalid-plan" role="alert">@IssueText(issue)</p>
        }
    }

    <section class="data-section dividend-allowance-section">
        <details>
            <summary><strong>Preliminary 2027 dividend allowance</strong></summary>
            <div class="dividend-form">
                <fieldset class="dividend-group">
                    <legend>Ownership</legend>
                    <div class="dividend-fields ownership-fields">
                        <label class="dividend-field"><span>Your ownership</span><span class="dividend-input"><input type="number" min="0" max="100" step="0.01" @bind="OwnershipPercentText" /><span aria-hidden="true">%</span></span></label>
                        <label class="dividend-field"><span>Spouse ownership</span><span class="dividend-input"><input type="number" min="0" max="100" step="0.01" @bind="SpouseOwnershipPercentText" /><span aria-hidden="true">%</span></span></label>
                        <label class="dividend-field"><span>Ownership in other qualified companies</span><span class="dividend-input"><input type="number" min="0" max="10000" step="0.01" @bind="OtherOwnershipPercentText" /><span aria-hidden="true">%</span></span></label>
                    </div>
                </fieldset>
                <fieldset class="dividend-group">
                    <legend>Salary and payroll · 2026</legend>
                    <label class="check-field dividend-toggle">
                        <input type="checkbox" @bind="Plan.DividendAllowance.OnePersonCompany" />
                        <span>One-person company — marked salary is total payroll</span>
                    </label>
                    @if (!Plan.DividendAllowance.OnePersonCompany)
                    {
                        <div class="dividend-fields">
                            <label class="dividend-field"><span>Company/group payroll in 2026</span><span class="dividend-input"><input type="number" min="0" @bind="Plan.DividendAllowance.CompanyCashPayroll2026" /><span aria-hidden="true">SEK</span></span></label>
                            <label class="dividend-field"><span>Highest related person's salary</span><span class="dividend-input"><input type="number" min="0" @bind="Plan.DividendAllowance.HighestRelatedCashSalary2026" /><span aria-hidden="true">SEK</span></span></label>
                        </div>
                    }
                </fieldset>
                <fieldset class="dividend-group">
                    <legend>Acquisition cost and saved allowance</legend>
                    <div class="dividend-fields">
                        <label class="dividend-field"><span>Acquisition cost</span><span class="dividend-input"><input type="number" min="0" @bind="Plan.DividendAllowance.AcquisitionCost" /><span aria-hidden="true">SEK</span></span></label>
                        <label class="dividend-field"><span>Saved allowance</span><span class="dividend-input"><input type="number" min="0" @bind="Plan.DividendAllowance.SavedAllowance" /><span aria-hidden="true">SEK</span></span></label>
                    </div>
                    <label class="check-field dividend-toggle interest-toggle">
                        <input type="checkbox" @bind="HasAcquisitionInterestRate" />
                        <span>Enter a 2027 acquisition-cost interest rate</span>
                    </label>
                    @if (HasAcquisitionInterestRate)
                    {
                        <div class="dividend-fields">
                            <div>
                                <label class="dividend-field"><span>Total acquisition-cost interest rate</span><span class="dividend-input"><input type="number" min="0" max="100" step="0.01" @bind="AcquisitionInterestPercentText" /><span aria-hidden="true">%</span></span></label>
                                <p class="dividend-hint">Government borrowing rate plus 9 percentage points.</p>
                            </div>
                        </div>
                    }
                </fieldset>
            </div>
            @if (result?.Dividend.Allowance is { } allowance)
            {
                <dl class="value-list comparison-list">
                    <div class="total-row"><dt>Maximum dividend at 20%</dt><dd>@FormatSek(allowance.Total)</dd></div>
                    <div><dt>Basic amount</dt><dd>@FormatSek(allowance.BasicAmount)</dd></div>
                    <div><dt>Company/group cash payroll</dt><dd>@FormatSek(allowance.CompanyCashPayroll)</dd></div>
                    <div><dt>Joint wage basis</dt><dd>@FormatSek(allowance.JointWageBasis)</dd></div>
                    <div><dt>Joint wage basis after deduction</dt><dd>@FormatSek(allowance.JointWageBasisAfterDeduction)</dd></div>
                    <div><dt>Your wage allowance before cap</dt><dd>@FormatSek(allowance.WageAllowanceBeforeCap)</dd></div>
                    <div><dt>Salary used for wage cap</dt><dd>@FormatSek(allowance.WageCapSalary)</dd></div>
                    <div><dt>50-times-salary cap</dt><dd>@FormatSek(allowance.WageCap)</dd></div>
                    <div><dt>Acquisition-cost interest basis</dt><dd>@FormatSek(allowance.AcquisitionCostInterestBasis)</dd></div>
                    <div><dt>Acquisition-cost interest</dt><dd>@FormatSek(allowance.AcquisitionCostInterest)</dd></div>
                    <div><dt>Saved allowance</dt><dd>@FormatSek(allowance.SavedAllowance)</dd></div>
                    <div><dt>Wage-based allowance</dt><dd>@FormatSek(allowance.WageAllowance)</dd></div>
                    <div><dt>Personal tax if fully used</dt><dd>@FormatSek(allowance.TaxAtTwentyPercent)</dd></div>
                    <div class="total-row"><dt>Net after 20% tax</dt><dd>@FormatSek(allowance.NetAfterTwentyPercentTax)</dd></div>
                    <div><dt>Marked 2026 own-company salary</dt><dd>@FormatSek(allowance.OwnerCashSalary)</dd></div>
                </dl>
            }
            else if (result?.Dividend.Issue is { } issue)
            {
                <p class="invalid-plan">@DividendAllowanceIssueText(issue)</p>
            }
            <p class="section-copy">The actual dividend also requires sufficient free equity, a prudence assessment, and a shareholder decision. Dividend paid in 2027 is declared on K10 in 2028.</p>
        </details>
    </section>

    </fieldset>
    <footer class="page-footer">
        Preliminary estimate based on Skatteverket tables and SKV 433, edition 36. Dividend tax assumes the amount is within the applicable gränsbelopp. Försäkringskassan determines actual SGI.
    </footer>
</main>

@code {
    private PlanResult? result;
    private EngineIssue? issue;
    private string statusText = "Loading the calculator…";
    private string? engineError;
    private string? storageWarning;
    private bool initialized;
    private bool canSave = true;
    private bool disposed;
    private readonly CalculationRevision revisions = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        try
        {
            var saved = await Engine.LoadWorkspaceAsync();
            if (saved is not null)
            {
                try
                {
                    var workspace = SavedWorkspace.Restore(saved);
                    table = workspace.Table;
                    ageGroup = workspace.AgeGroup;
                    Plan = workspace.Plan;
                }
                catch (System.Text.Json.JsonException)
                {
                    canSave = false;
                    storageWarning = "The saved plan could not be restored. It has been preserved; edits will not overwrite it until you choose to replace it.";
                }
            }
        }
        catch (JSException)
        {
            canSave = false;
            storageWarning = "The saved plan could not be read. It has been preserved; edits will not overwrite it until you choose to replace it.";
        }
        initialized = true;
        await RecalculateAsync();
    }

    private Task RetryAsync() => initialized ? RecalculateAsync() : InitializeAsync();
    private void UseCurrentWorkspace() { canSave = true; storageWarning = null; }
    private void RowChanged() { }

    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        if (initialized && !disposed) await RecalculateAsync();
        else StateHasChanged();
    }

    private async Task RecalculateAsync()
    {
        var revision = revisions.Next();
        result = null;
        issue = null;
        engineError = null;
        foreach (var entry in Plan.Entries) entry.Result = null;
        statusText = "Calculating locally…";
        StateHasChanged();
        // Capture the complete edited workspace before yielding. No financial inputs leave the browser.
        var saved = new SavedWorkspace(table, ageGroup, Plan).Serialize();
        if (canSave)
        {
            try { await Engine.SaveWorkspaceAsync(saved); }
            catch (JSException) { storageWarning = "This browser cannot save the plan. Keep this page open to retain your edits."; }
        }
        await Task.Delay(120);
        if (!revisions.IsCurrent(revision) || disposed) return;
        try
        {
            var response = await Engine.CalculateAsync(table, ageGroup, Plan);
            if (!revisions.IsCurrent(revision) || disposed) return;
            result = response.Result;
            issue = response.Issue;
            foreach (var entry in Plan.Entries)
                entry.Result = result?.Entries.FirstOrDefault(e => e.EntryId == entry.Id);
            statusText = "Calculated locally on this device. Your plan stays in this browser.";
        }
        catch (Exception ex) when (ex is SwedishTax.Native.TaxEngineException)
        {
            if (!revisions.IsCurrent(revision) || disposed) return;
            engineError = "The Rust engine could not calculate this plan. Retry, or reload the application. " + ex.Message;
            statusText = "Calculation unavailable.";
        }
        StateHasChanged();
    }

    private string IssueText(EngineIssue value)
    {
        var name = Plan.Entries.FirstOrDefault(e => e.Id == value.EntryId);
        var label = name is null ? "Income row" : EntryName(name);
        return value.Kind switch
        {
            EngineIssueKind.InvalidPaymentPeriod => $"{label}: the last payment day must be on or after the first day.",
            EngineIssueKind.SalaryExchangeExceedsAllowance => $"{label}: salary exchange exceeds the allowance. The maximum is {FormatSek(value.Maximum ?? 0)}. Update the exchanged salary to calculate tax.",
            EngineIssueKind.UnsupportedTaxTable => "Select a supported tax table (29–42).",
            _ => "The plan contains invalid input. Check its values before calculating.",
        };
    }

    public void Dispose() { disposed = true; revisions.Next(); }

    private static readonly NumberFormatInfo SekFormat = new() { NumberDecimalDigits = 0, NumberGroupSeparator = " " };
    private byte table = 32;
    private TaxAgeGroup ageGroup = TaxAgeGroup.Under66AtYearStart;
    private IncomePlan Plan = IncomePlan.WithMonthlySalary(660_400 / 12);
    private IncomeKind newIncomeKind = IncomeKind.AnnualSalary;
    private bool editorOpen;

    private WithholdingSummary CurrentWithholding => result?.Withholding ?? new(0, []);
    private bool HasAdjustment { get => Plan.AdjustmentPercent.HasValue; set => Plan.SetAdjustmentEnabled(value); }
    private uint AdjustmentPercent { get => Plan.AdjustmentPercent ?? 0; set => Plan.AdjustmentPercent = Math.Min(value, 100); }


    private bool HasAcquisitionInterestRate
    {
        get => Plan.DividendAllowance.AcquisitionCostInterestBasisPoints.HasValue;
        set => Plan.DividendAllowance.AcquisitionCostInterestBasisPoints = value ? 0U : null;
    }
    private string AcquisitionInterestPercentText
    {
        get => PercentageText.FormatBasisPoints(Plan.DividendAllowance.AcquisitionCostInterestBasisPoints ?? 0);
        set { if (PercentageText.TryParseBasisPoints(value, 10_000, out var rate)) Plan.DividendAllowance.AcquisitionCostInterestBasisPoints = rate; }
    }
    private string OwnershipPercentText
    {
        get => PercentageText.FormatBasisPoints(Plan.DividendAllowance.OwnershipBasisPoints);
        set
        {
            if (PercentageText.TryParseBasisPoints(value, 10_000, out var basisPoints))
                Plan.DividendAllowance.OwnershipBasisPoints = basisPoints;
        }
    }
    private string SpouseOwnershipPercentText
    {
        get => PercentageText.FormatBasisPoints(Plan.DividendAllowance.SpouseOwnershipBasisPoints);
        set
        {
            if (PercentageText.TryParseBasisPoints(value, 10_000, out var basisPoints))
                Plan.DividendAllowance.SpouseOwnershipBasisPoints = basisPoints;
        }
    }
    private string OtherOwnershipPercentText
    {
        get => PercentageText.FormatBasisPoints(Plan.DividendAllowance.OtherQualifiedOwnershipBasisPoints);
        set
        {
            if (PercentageText.TryParseBasisPoints(value, 1_000_000, out var basisPoints))
                Plan.DividendAllowance.OtherQualifiedOwnershipBasisPoints = basisPoints;
        }
    }

    private void AddIncome() => Plan.AddEntry(newIncomeKind);
    private void RemoveEntry(ulong id) => Plan.RemoveEntry(id);

    private static string FormatSek(uint value) => $"{value.ToString("N", SekFormat)} SEK";
    private static string FormatCredit(uint value) => value == 0 ? FormatSek(0) : $"−{FormatSek(value)}";
    private static string FormatSignedSek(long value) => value < 0 ? $"−{FormatSek((uint)-value)}" : FormatSek((uint)value);
    private static string FormatDeduction(TaxDeduction deduction) => deduction.Kind == TaxDeductionKind.Amount ? $"{FormatSek(deduction.Value)} / month" : $"{deduction.Value}% of payment";
    private static string TaxBalanceSummary(long balance) => balance switch { > 0 => $"Expected kvarskatt: {FormatSek((uint)balance)}", < 0 => $"Expected refund: {FormatSek((uint)-balance)}", _ => "No expected balance" };
    private static string EntryName(IncomeEntry entry) => string.IsNullOrWhiteSpace(entry.Description) ? entry.Kind.Label() : entry.Description;
    private static string CashEquation(IncomeEntry entry) => entry.Kind.IsMonthly() ? $"{FormatSek(entry.Amount)} monthly over selected dates" : entry.Kind == IncomeKind.OwnCompanyDividend ? "dividend cash" : "entered annual/one-time cash";
    private static string WithholdingRuleText(AppliedWithholding rule) => rule.Kind switch
    {
        AppliedWithholdingKind.ActualAmount => "entered actual amount",
        AppliedWithholdingKind.Table => $"table column {(byte)rule.Column!}",
        AppliedWithholdingKind.TableAndOneTime => $"table column {(byte)rule.Column!} + one-time table {rule.Percent}%",
        AppliedWithholdingKind.OneTimeTable => $"one-time table {rule.Percent}%",
        AppliedWithholdingKind.Secondary30 => "secondary payer 30%",
        AppliedWithholdingKind.AdjustmentPercent => $"jämkning {rule.Percent}%",
        _ => "no withholding",
    };
    private static string AdditionalRuleText(EntryWithholding withholding) =>
        withholding.AdditionalWithheld == 0
            ? string.Empty
            : $" + {FormatSek(withholding.AdditionalWithheld)} voluntary extra";
    private static string DividendAllowanceIssueText(DividendAllowanceIssue issue) => issue switch
    {
        DividendAllowanceIssue.OwnershipExceedsOneHundredPercent => "Your ownership in this company cannot exceed 100%.",
        DividendAllowanceIssue.SpouseOwnershipExceedsCompany => "Your and your spouse's combined ownership cannot exceed 100%.",
        DividendAllowanceIssue.PersonalSalaryExceedsCompanyPayroll => "Owner or related-person salary cannot exceed company/group payroll.",
        _ => "The exact 2027 acquisition-cost interest rate is not known until 30 November 2026.",
    };

    private static RenderFragment IncomeBasisCard(string label, IncomeBasisEstimate estimate) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "article");
        builder.AddAttribute(sequence++, "class", "basis-card");
        builder.OpenElement(sequence++, "strong"); builder.AddContent(sequence++, label); builder.CloseElement();
        if (estimate.Kind == IncomeBasisEstimateKind.Estimated)
        {
            builder.OpenElement(sequence++, "progress");
            builder.AddAttribute(sequence++, "max", 100);
            builder.AddAttribute(sequence++, "value", estimate.Progress!.PercentOfMaximum);
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, $"{estimate.Progress!.PercentOfMaximum:F1}% of 2026 maximum");
            builder.CloseElement();
            builder.OpenElement(sequence++, "small");
            builder.AddContent(sequence++, $"{FormatSek(estimate.Progress!.EstimatedBasis)} / {FormatSek(estimate.Progress!.MaximumBasis)}");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

}
