@implements IHandleEvent

<article class="income-entry-card">
    <div class="entry-heading">
        <label>
            <span>Description</span>
            <input type="text" maxlength="80" @bind="Entry.Description" />
        </label>
        <button type="button" class="danger-button" @onclick="Remove">Remove</button>
    </div>

    <div class="entry-grid">
        <label class="wide-field">
            <span>Income type</span>
            <select value="@Entry.Kind" @onchange="KindChanged">
                @foreach (var kind in Enum.GetValues<IncomeKind>())
                {
                    <option value="@kind">@kind.Label()</option>
                }
            </select>
        </label>
        <label>
            <span>@AmountLabel</span>
            <div class="unit-input">
                <input type="number" min="0" max="100000000" step="1"
                       @bind="Entry.Amount" @bind:event="oninput" />
                <small>SEK</small>
            </div>
        </label>
        <label>
            <span>Payer role</span>
            <select value="@Entry.PayerRole" @onchange="PayerRoleChanged">
                <option value="@PayerRole.Main">Main payer</option>
                <option value="@PayerRole.Secondary">Secondary payer (@(30)%)</option>
            </select>
        </label>
    </div>

    @if (Entry.Kind.IsMonthly())
    {
        <div class="entry-grid period-grid">
            <label>
                <span>First day · month</span>
                <select @bind="StartMonth">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@MonthNames[month - 1]</option>
                    }
                </select>
            </label>
            <label>
                <span>First day · day</span>
                <select @bind="StartDay">
                    @for (var day = 1; day <= Date2026.DaysInMonth(StartMonth); day++)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
            </label>
            <label>
                <span>Last day · month</span>
                <select @bind="EndMonth">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@MonthNames[month - 1]</option>
                    }
                </select>
            </label>
            <label>
                <span>Last day · day</span>
                <select @bind="EndDay">
                    @for (var day = 1; day <= Date2026.DaysInMonth(EndMonth); day++)
                    {
                        <option value="@day">@day</option>
                    }
                </select>
            </label>
        </div>
        <label class="check-field"><input type="checkbox" @bind="Entry.UseAnnualDailyRateForPartialMonths" /><span>Use monthly amount × 12 / 365 for partial months</span></label>
        <p class="microcopy">Both the first and last day are included. Full months use the monthly amount. Partial months use calendar days unless the annual daily rate is selected.</p>
        @if (!Entry.IsValid)
        {
            <p class="field-error">The last day must be on or after the first day.</p>
        }
    }

    @if (!Entry.Kind.IsDividend())
    {
        <div class="option-grid">
            @if (HasAdjustment)
            {
                <label class="check-field">
                    <input type="checkbox" @bind="Entry.AdjustmentApplies" />
                    <span>Apply the jämkning rate to this income</span>
                </label>
            }
            @if (Entry.Kind is IncomeKind.AnnualSalary or IncomeKind.MonthlySalary)
            {
                <label class="check-field">
                    <input type="checkbox" @bind="Entry.UseFullYearProjectionAsAdjustmentBasis" />
                    <span>Use the full-year salary projection as the jämkning basis</span>
                </label>
            }
        </div>
    }

    @if (Entry.Kind.IsSalary())
    {
        <label class="check-field">
            <input type="checkbox" @bind="Entry.OwnCompanySourced" />
            <span>Paid by my own company or qualifying group</span>
        </label>
    }

    <div class="option-grid">
        <label class="check-field">
            <input type="checkbox" @bind="HasActualWithholding" />
            <span>Use actual tax withheld</span>
        </label>
        @if (HasActualWithholding)
        {
            <label class="inline-number">
                <span>Actual tax withheld</span>
                <input type="number" min="0" max="100000000" @bind="ActualWithholding" />
                <small>SEK</small>
            </label>
            <p class="microcopy">Use this after payments have been made. It replaces the estimated table, secondary-payer, jämkning, and voluntary-extra amounts for this row.</p>
        }
        @if (!Entry.Kind.IsDividend())
        {
            <label class="check-field">
                <input type="checkbox" @bind="HasAdditionalWithholding" />
                <span>Add voluntary extra withholding</span>
            </label>
            @if (HasAdditionalWithholding)
            {
                <label class="inline-number">
                    <span>@(Entry.WithholdingPaymentCount > 1 ? "Extra per payment" : "Extra withholding")</span>
                    <input type="number" min="0" max="100000000" @bind="AdditionalWithholdingPerPayment" />
                    <small>SEK</small>
                </label>
                <p class="microcopy">Added on top of normal withholding for each payment. Planned extra for period: @FormatSek(Entry.RequestedAdditionalWithholding).</p>
            }
        }
    </div>

    @if (Entry.Kind == IncomeKind.MonthlySalary)
    {
        <details class="entry-details">
            <summary>Vacation payout and occupational pension</summary>
            <label class="check-field">
                <input type="checkbox" @bind="HasVacationCompensation" />
                <span>Add vacation compensation</span>
            </label>
            @if (HasVacationCompensation)
            {
                <div class="entry-grid compact-grid">
                    <label><span>Annual entitlement</span><input type="number" min="0" max="100" @bind="VacationEntitlementDays" /></label>
                    <label><span>Daily share of monthly salary</span><input type="number" min="0" max="100" step="0.01" @bind="VacationRatePercentText" /><small>% per paid day</small></label>
                    <label><span>Payout days</span><input type="number" min="0" max="366" @bind="VacationPayoutDays" /></label>
                    <label class="check-field"><input type="checkbox" @bind="VacationInPensionBasis" /><span>Treat this vacation payout as pensionable</span></label>
                </div>
                <p class="microcopy">The editable default is 5.4% of monthly salary per paid day. Use the rate in your agreement.</p>
                <button type="button" class="secondary-button" @onclick="UseSuggestedVacationDays" disabled="@(Entry.Result is null)">Use suggested days (@(Entry.Result?.SuggestedVacationDays))</button>
                <p class="microcopy">Estimated vacation payout: @FormatSek(Entry.VacationCompensationAmount)</p>
                @if (VacationInPensionBasis)
                {
                    @if (!HasVacationPensionOverride)
                    {
                        <p class="microcopy">Calculated pension contribution for this vacation payout: @FormatSek(Entry.VacationPensionPremiumAmount)</p>
                    }
                    <label class="check-field">
                        <input type="checkbox" @bind="HasVacationPensionOverride" />
                        <span>Use actual pension contribution for this vacation payout</span>
                    </label>
                    @if (HasVacationPensionOverride)
                    {
                        <label class="inline-number">
                            <span>Actual pension contribution for vacation payout</span>
                            <input type="number" min="0" max="100000000" @bind="ActualVacationPensionContribution" />
                            <small>SEK</small>
                        </label>
                    }
                }
            }

            <label class="check-field">
                <input type="checkbox" @bind="Entry.IncludedInPensionSalaryBasis" />
                <span>Treat this salary as pensionable</span>
            </label>
            <label class="check-field">
                <input type="checkbox" @bind="HasRegularPension" />
                <span>Include an employer occupational-pension contribution</span>
            </label>
            @if (HasRegularPension)
            {
                <p class="microcopy">Calculated monthly benchmark: @FormatSek(PensionBenchmarkMonthly)</p>
                <label class="check-field">
                    <input type="checkbox" @bind="HasPensionOverride" />
                    <span>Use actual monthly pension contribution</span>
                </label>
                @if (HasPensionOverride)
                {
                    <label class="inline-number">
                        <span>Actual monthly pension contribution</span>
                        <input type="number" min="0" max="100000000" @bind="ActualMonthlyPensionContribution" />
                        <small>SEK</small>
                    </label>
                }
                <p class="microcopy">Annual employer contribution: @FormatSek(Entry.RegularPensionPremiumAmount)</p>
            }
        </details>
    }

    @if (Entry.Kind == IncomeKind.AnnualSalary)
    {
        <details class="entry-details">
            <summary>Occupational pension</summary>
            <label class="check-field">
                <input type="checkbox" @bind="Entry.IncludedInPensionSalaryBasis" />
                <span>Treat this salary as pensionable</span>
            </label>
            <label class="check-field">
                <input type="checkbox" @bind="HasRegularPension" />
                <span>Include an employer occupational-pension contribution</span>
            </label>
            @if (HasRegularPension)
            {
                <p class="microcopy">Calculated monthly benchmark: @FormatSek(PensionBenchmarkMonthly)</p>
                <label class="check-field">
                    <input type="checkbox" @bind="HasPensionOverride" />
                    <span>Use actual monthly pension contribution</span>
                </label>
                @if (HasPensionOverride)
                {
                    <label class="inline-number">
                        <span>Actual monthly pension contribution</span>
                        <input type="number" min="0" max="100000000" @bind="ActualMonthlyPensionContribution" />
                        <small>SEK</small>
                    </label>
                }
                <p class="microcopy">Annual employer contribution: @FormatSek(Entry.RegularPensionPremiumAmount)</p>
            }
        </details>
    }

    @if (Entry.Kind == IncomeKind.OneTimeSalary)
    {
        <details class="entry-details">
            <summary>Salary exchange</summary>
            <label class="check-field">
                <input type="checkbox" @bind="HasSalaryExchange" />
                <span>Exchange part of this payment for pension</span>
            </label>
            @if (HasSalaryExchange)
            {
                <div class="entry-grid compact-grid">
                    <label><span>Salary to exchange</span><input type="number" min="0" max="@Entry.Amount" @bind="SalaryExchangeSacrifice" /></label>
                    <label><span>Employer uplift</span><input type="number" min="0" max="100" step="0.01" @bind="SalaryExchangeUpliftPercentText" /><small>%</small></label>
                    <label class="check-field"><input type="checkbox" @bind="SalaryExchangeAddsUplift" /><span>Employer adds uplift</span></label>
                    <label class="check-field"><input type="checkbox" @bind="Entry.IncludedInPensionSalaryBasis" /><span>Treat this payment as pensionable</span></label>
                </div>
                <div class="option-grid">
                    <label class="check-field"><input type="checkbox" @bind="HasPreviousYearBasis" /><span>Use preceding-year pensionable salary for the allowance</span></label>
                    @if (HasPreviousYearBasis)
                    {
                        <label><span>Preceding-year pensionable salary</span><input type="number" min="0" @bind="PreviousYearBasis" /><small>SEK</small></label>
                    }
                    <label class="check-field"><input type="checkbox" @bind="HasConfirmedCosts" /><span>Use confirmed pension and insurance costs before this exchange</span></label>
                    @if (HasConfirmedCosts)
                    {
                        <label><span>Confirmed costs before this exchange</span><input type="number" min="0" @bind="ConfirmedCosts" /><small>SEK</small></label>
                    }
                </div>
                <p class="microcopy">A preceding-year salary basis stays fixed when salary is exchanged. Confirmed costs replace the modeled regular, vacation and other exchange contributions in this allowance calculation.</p>
                @if (Allowance is { } allowance)
                {
                    <dl class="value-list comparison-list">
                        <div><dt>Pensionable salary before exchange</dt><dd>@FormatSek(allowance.PensionSalaryBasisBefore)</dd></div>
                        <div><dt>Pensionable salary after exchange</dt><dd>@FormatSek(allowance.PensionSalaryBasisAfter)</dd></div>
                        <div><dt>35% contribution ceiling</dt><dd>@FormatSek(allowance.Ceiling)</dd></div>
                        <div><dt>Costs before this exchange</dt><dd>@FormatSek(allowance.PensionContributionsBefore)</dd></div>
                        <div><dt>Regular pension estimate</dt><dd>@FormatSek(allowance.RegularPensionPremiums)</dd></div>
                        <div><dt>Vacation pension estimate</dt><dd>@FormatSek(allowance.VacationPensionPremiums)</dd></div>
                        <div><dt>Other exchange contributions</dt><dd>@FormatSek(allowance.OtherExchangeContributions)</dd></div>
                        <div><dt>Selected contribution within allowance</dt><dd>@FormatSek(allowance.SelectedExchangeContribution)</dd></div>
                        <div><dt>Total costs counted against allowance</dt><dd>@FormatSek(allowance.TotalEmployerPensionContributions)</dd></div>
                        <div><dt>Share of allowance salary basis</dt><dd>@allowance.ContributionShareOfBasis.ToString("F2")%</dd></div>
                        <div><dt>Contribution room</dt><dd>@FormatSek(allowance.AvailableContribution)</dd></div>
                    </dl>
                    <p class="microcopy">
                        Resulting pension contribution @FormatSek(Entry.SalaryExchangePensionContribution).
                        Maximum salary exchange within the 35% allowance: @FormatSek(allowance.MaximumSacrifice).
                    </p>
                }
            }
        </details>
    }

    @if (Entry.Result is not null)
    {
    <footer class="entry-result">
        <span>@EligibilityText</span>
        <span>@CashSummaryLabel <strong>@FormatSek(Entry.TotalAnnualAmount)</strong></span>
        @if (Withholding is { } withholding)
        {
            <span>Calculated withholding <strong>@FormatSek(withholding.Withheld)</strong> · @RuleText(withholding.Rule)@AdditionalRuleText(withholding)</span>
        }
    </footer>
    }
</article>

@code {
    private static readonly string[] MonthNames =
        ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    [Parameter, EditorRequired] public IncomeEntry Entry { get; set; } = null!;
    [Parameter] public bool HasAdjustment { get; set; }
    [Parameter] public EntryWithholding? Withholding { get; set; }
    [Parameter] public SalaryExchangeAllowance? Allowance { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }
    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        await OnChange.InvokeAsync();
        StateHasChanged();
    }
    [Parameter] public EventCallback<ulong> OnRemove { get; set; }

    private string AmountLabel => Entry.Kind switch
    {
        IncomeKind.MonthlySalary or IncomeKind.MonthlyOccupationalPension => "Monthly amount",
        IncomeKind.OneTimeSalary or IncomeKind.OwnCompanyDividend => "One-time amount",
        _ => "Annual amount",
    };

    private string CashSummaryLabel => Entry.Kind switch
    {
        IncomeKind.OneTimeSalary or IncomeKind.OwnCompanyDividend => "One-time total",
        _ => "Annual cash",
    };

    private string EligibilityText => Entry.Kind switch
    {
        IncomeKind.AnnualSalary or IncomeKind.MonthlySalary => "PGI eligible · SGI estimate eligible",
        IncomeKind.OneTimeSalary => "PGI eligible · does not establish ongoing SGI",
        _ => "PGI — · SGI —",
    };

    private byte StartMonth
    {
        get => Entry.Start.Clamped.Month;
        set
        {
            var month = Math.Clamp(value, (byte)1, (byte)12);
            Entry.Start = new(month, Math.Min(Entry.Start.Clamped.Day, Date2026.DaysInMonth(month)));
        }
    }
    private byte StartDay
    {
        get => Entry.Start.Clamped.Day;
        set => Entry.Start = new(StartMonth, Math.Clamp(value, (byte)1, Date2026.DaysInMonth(StartMonth)));
    }
    private byte EndMonth
    {
        get => Entry.End.Clamped.Month;
        set
        {
            var month = Math.Clamp(value, (byte)1, (byte)12);
            Entry.End = new(month, Math.Min(Entry.End.Clamped.Day, Date2026.DaysInMonth(month)));
        }
    }
    private byte EndDay
    {
        get => Entry.End.Clamped.Day;
        set => Entry.End = new(EndMonth, Math.Clamp(value, (byte)1, Date2026.DaysInMonth(EndMonth)));
    }

    private bool HasAdditionalWithholding
    {
        get => Entry.AdditionalWithholdingPerPayment.HasValue;
        set
        {
            Entry.AdditionalWithholdingPerPayment = value ? 1_000 : null;
            if (value) Entry.ActualWithholding = null;
        }
    }
    private uint AdditionalWithholdingPerPayment
    {
        get => Entry.AdditionalWithholdingPerPayment ?? 0;
        set => Entry.AdditionalWithholdingPerPayment = value;
    }

    private bool HasActualWithholding
    {
        get => Entry.ActualWithholding.HasValue;
        set
        {
            Entry.ActualWithholding = value ? 0 : null;
            if (value) Entry.AdditionalWithholdingPerPayment = null;
        }
    }
    private uint ActualWithholding
    {
        get => Entry.ActualWithholding ?? 0;
        set => Entry.ActualWithholding = value;
    }

    private bool HasVacationCompensation
    {
        get => Entry.VacationCompensation.HasValue;
        set => Entry.VacationCompensation = value
            ? SwedishTax.Native.NativeCalculator.NewVacationCompensation(25, Entry.Result?.SuggestedVacationDays ?? 0)
            : null;
    }
    private uint VacationEntitlementDays
    {
        get => Entry.VacationCompensation?.AnnualEntitlementDays ?? 0;
        set { if (Entry.VacationCompensation is { } vacation) Entry.VacationCompensation = vacation with { AnnualEntitlementDays = value }; }
    }
    private uint VacationPayoutDays
    {
        get => Entry.VacationCompensation?.PayoutDays ?? 0;
        set { if (Entry.VacationCompensation is { } vacation) Entry.VacationCompensation = vacation with { PayoutDays = value }; }
    }
    private bool VacationInPensionBasis
    {
        get => Entry.VacationCompensation?.IncludedInPensionSalaryBasis ?? false;
        set
        {
            if (Entry.VacationCompensation is not { } vacation) return;
            Entry.VacationCompensation = vacation with
            {
                IncludedInPensionSalaryBasis = value,
                PensionPremiumOverride = value ? vacation.PensionPremiumOverride : null,
            };
        }
    }
    private bool HasVacationPensionOverride
    {
        get => Entry.VacationCompensation?.PensionPremiumOverride.HasValue ?? false;
        set
        {
            if (Entry.VacationCompensation is not { } vacation) return;
            Entry.VacationCompensation = vacation with
            {
                PensionPremiumOverride = value ? Entry.VacationPensionPremiumAmount : null,
            };
        }
    }
    private uint ActualVacationPensionContribution
    {
        get => Entry.VacationCompensation?.PensionPremiumOverride ?? 0;
        set
        {
            if (Entry.VacationCompensation is { } vacation)
                Entry.VacationCompensation = vacation with { PensionPremiumOverride = value };
        }
    }

    private bool HasRegularPension
    {
        get => Entry.RegularPensionPremium.HasValue;
        set => Entry.RegularPensionPremium = value ? new RegularPensionPremium() : null;
    }
    private uint PensionBenchmarkMonthly => Entry.Result?.PensionBenchmarkMonthly ?? 0;
    private bool HasPensionOverride
    {
        get => Entry.RegularPensionPremium?.MonthlyOverride.HasValue ?? false;
        set
        {
            if (Entry.RegularPensionPremium is { } premium)
                Entry.RegularPensionPremium = premium with { MonthlyOverride = value ? PensionBenchmarkMonthly : null };
        }
    }
    private uint ActualMonthlyPensionContribution
    {
        get => Entry.RegularPensionPremium?.MonthlyOverride ?? 0;
        set
        {
            if (Entry.RegularPensionPremium is { } premium)
                Entry.RegularPensionPremium = premium with { MonthlyOverride = value };
        }
    }

    private void UseSuggestedVacationDays()
    {
        if (Entry.Result is { } result) VacationPayoutDays = result.SuggestedVacationDays;
    }
    private string VacationRatePercentText
    {
        get => PercentageText.FormatBasisPoints(Entry.VacationCompensation?.RateBasisPoints ?? SwedishTax.Native.NativeCalculator.DefaultVacationRateBasisPoints);
        set
        {
            if (Entry.VacationCompensation is { } vacation && PercentageText.TryParseBasisPoints(value, 10_000, out var rate))
                Entry.VacationCompensation = vacation with { RateBasisPoints = rate };
        }
    }
    private bool HasPreviousYearBasis
    {
        get => Entry.SalaryExchange?.PreviousYearPensionSalaryBasis.HasValue ?? false;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { PreviousYearPensionSalaryBasis = value ? Allowance?.PensionSalaryBasisBefore ?? 0 : null }; }
    }
    private uint PreviousYearBasis
    {
        get => Entry.SalaryExchange?.PreviousYearPensionSalaryBasis ?? 0;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { PreviousYearPensionSalaryBasis = value }; }
    }
    private bool HasConfirmedCosts
    {
        get => Entry.SalaryExchange?.PensionAndInsuranceCostsBeforeExchange.HasValue ?? false;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { PensionAndInsuranceCostsBeforeExchange = value ? Allowance?.PensionContributionsBefore ?? 0 : null }; }
    }
    private uint ConfirmedCosts
    {
        get => Entry.SalaryExchange?.PensionAndInsuranceCostsBeforeExchange ?? 0;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { PensionAndInsuranceCostsBeforeExchange = value }; }
    }

    private bool HasSalaryExchange
    {
        get => Entry.SalaryExchange.HasValue;
        set => Entry.SalaryExchange = value ? SwedishTax.Native.NativeCalculator.NewSalaryExchange() : null;
    }
    private uint SalaryExchangeSacrifice
    {
        get => Entry.SalaryExchange?.SacrificedSalary ?? 0;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { SacrificedSalary = Math.Min(value, Entry.Amount) }; }
    }
    private bool SalaryExchangeAddsUplift
    {
        get => Entry.SalaryExchange?.EmployerAddsUplift ?? false;
        set { if (Entry.SalaryExchange is { } exchange) Entry.SalaryExchange = exchange with { EmployerAddsUplift = value }; }
    }
    private string SalaryExchangeUpliftPercentText
    {
        get => PercentageText.FormatBasisPoints(Entry.SalaryExchange?.UpliftBasisPoints ?? 0);
        set
        {
            if (Entry.SalaryExchange is not { } exchange) return;
            if (PercentageText.TryParseBasisPoints(value, 10_000, out var basisPoints))
                Entry.SalaryExchange = exchange with { UpliftBasisPoints = basisPoints };
        }
    }

    private Task Remove() => OnRemove.InvokeAsync(Entry.Id);

    private void KindChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse<IncomeKind>(args.Value?.ToString(), out var kind)) return;
        Entry.SetKind(kind, HasAdjustment);
    }

    private void PayerRoleChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse<PayerRole>(args.Value?.ToString(), out var role)) return;
        Entry.SetPayerRole(role, HasAdjustment);
    }

    private static string RuleText(AppliedWithholding rule) => rule.Kind switch
    {
        AppliedWithholdingKind.ActualAmount => "entered actual amount",
        AppliedWithholdingKind.Table => $"table column {(byte)rule.Column!}",
        AppliedWithholdingKind.TableAndOneTime => $"table column {(byte)rule.Column!} plus one-time table at {rule.Percent}%",
        AppliedWithholdingKind.OneTimeTable => $"one-time-payment table at {rule.Percent}%",
        AppliedWithholdingKind.Secondary30 => "secondary payer at 30%",
        AppliedWithholdingKind.AdjustmentPercent => $"jämkning at {rule.Percent}%",
        _ => "no withholding",
    };

    private static string AdditionalRuleText(EntryWithholding withholding) =>
        withholding.AdditionalWithheld == 0
            ? string.Empty
            : $" + {FormatSek(withholding.AdditionalWithheld)} voluntary extra";

    private static string FormatSek(uint value) => $"{value:N0} SEK";
}
